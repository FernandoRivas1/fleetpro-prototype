# Copy to backend/.env (or rely on the root ../keys.env, which app/config.py
# also reads) and fill in real values. Never commit the filled-in file.

# Neon Postgres connection string. Accepts either postgres:// or
# postgresql:// — app/config.py normalizes it for SQLAlchemy.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/fleetpro?sslmode=require

# Used by app/checkout/documents.py (OCR of ID/license photos) via the
# Anthropic Python SDK.
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of origins allowed to call the API (executive web
# app + client tablet web app).
CORS_ORIGINS=http://localhost:5173

# Base URL of the client tablet web app — used to build each Station's QR
# pairing payload ("{APP_URL}/client?pair={station_id}.{pairing_token}").
APP_URL=http://localhost:5173

# How long a station pairing PIN (app/checkout/stations.py) stays valid.
STATION_PIN_TTL_SECONDS=300

# Where scanned ID/license photos are saved (app/checkout/documents.py),
# served back out at /uploads/... — relative paths resolve against the
# working directory the app was started from.
UPLOADS_DIR=uploads
